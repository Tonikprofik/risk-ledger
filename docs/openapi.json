{
  "components": {
    "schemas": {
      "ExclusionOut": {
        "description": "policy_not_found is book-wide (no Policy, so no Portfolio); the rest are this Portfolio's.",
        "properties": {
          "amount_dkk": {
            "description": "Incurred loss the excluded Claims would have had.",
            "title": "Amount Dkk",
            "type": "number"
          },
          "claim_count": {
            "minimum": 0.0,
            "title": "Claim Count",
            "type": "integer"
          },
          "reason": {
            "$ref": "#/components/schemas/ExclusionReason"
          }
        },
        "required": [
          "reason",
          "claim_count",
          "amount_dkk"
        ],
        "title": "ExclusionOut",
        "type": "object"
      },
      "ExclusionReason": {
        "enum": [
          "policy_not_found",
          "negative_paid_amount"
        ],
        "title": "ExclusionReason",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Peril": {
        "enum": [
          "fire",
          "flood",
          "hail",
          "storm",
          "subsidence"
        ],
        "title": "Peril",
        "type": "string"
      },
      "PerilLossExperienceOut": {
        "properties": {
          "claim_count": {
            "description": "Kept Claims of every status.",
            "minimum": 0.0,
            "title": "Claim Count",
            "type": "integer"
          },
          "earned_premium_dkk": {
            "description": "Full annual premium at the inception month.",
            "title": "Earned Premium Dkk",
            "type": "number"
          },
          "incurred_loss_dkk": {
            "title": "Incurred Loss Dkk",
            "type": "number"
          },
          "largest_claim_dkk": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "null when claim_count is 0.",
            "title": "Largest Claim Dkk"
          },
          "loss_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "incurred_loss_dkk / earned_premium_dkk; null when earned premium is 0.",
            "title": "Loss Ratio"
          },
          "peril": {
            "$ref": "#/components/schemas/Peril"
          },
          "policy_count": {
            "minimum": 0.0,
            "title": "Policy Count",
            "type": "integer"
          }
        },
        "required": [
          "peril",
          "policy_count",
          "earned_premium_dkk",
          "incurred_loss_dkk",
          "loss_ratio",
          "claim_count",
          "largest_claim_dkk"
        ],
        "title": "PerilLossExperienceOut",
        "type": "object"
      },
      "PortfolioLossExperienceOut": {
        "properties": {
          "exclusions": {
            "description": "Source Claims left out of every result, one row per reason.",
            "items": {
              "$ref": "#/components/schemas/ExclusionOut"
            },
            "title": "Exclusions",
            "type": "array"
          },
          "perils": {
            "description": "Every Peril, always listed.",
            "items": {
              "$ref": "#/components/schemas/PerilLossExperienceOut"
            },
            "title": "Perils",
            "type": "array"
          },
          "portfolio_id": {
            "title": "Portfolio Id",
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/PortfolioTotalOut",
            "description": "The six figures over every Peril."
          }
        },
        "required": [
          "portfolio_id",
          "total",
          "perils",
          "exclusions"
        ],
        "title": "PortfolioLossExperienceOut",
        "type": "object"
      },
      "PortfolioRankingOut": {
        "properties": {
          "portfolios": {
            "description": "Every Portfolio, worst first: total loss_ratio descending, ties by incurred_loss_dkk descending, then portfolio_id; null ratios last, by portfolio_id.",
            "items": {
              "$ref": "#/components/schemas/PortfolioLossExperienceOut"
            },
            "title": "Portfolios",
            "type": "array"
          }
        },
        "required": [
          "portfolios"
        ],
        "title": "PortfolioRankingOut",
        "type": "object"
      },
      "PortfolioTotalOut": {
        "description": "The six figures of a Peril row, summed over every Peril of the Portfolio.",
        "properties": {
          "claim_count": {
            "description": "Kept Claims of every status.",
            "minimum": 0.0,
            "title": "Claim Count",
            "type": "integer"
          },
          "earned_premium_dkk": {
            "description": "Full annual premium at the inception month.",
            "title": "Earned Premium Dkk",
            "type": "number"
          },
          "incurred_loss_dkk": {
            "title": "Incurred Loss Dkk",
            "type": "number"
          },
          "largest_claim_dkk": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "null when claim_count is 0.",
            "title": "Largest Claim Dkk"
          },
          "loss_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "incurred_loss_dkk / earned_premium_dkk; null when earned premium is 0.",
            "title": "Loss Ratio"
          },
          "policy_count": {
            "minimum": 0.0,
            "title": "Policy Count",
            "type": "integer"
          }
        },
        "required": [
          "policy_count",
          "earned_premium_dkk",
          "incurred_loss_dkk",
          "loss_ratio",
          "claim_count",
          "largest_claim_dkk"
        ],
        "title": "PortfolioTotalOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "the company loss experience",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/portfolios/loss-experience": {
      "get": {
        "operationId": "get_ranking_portfolios_loss_experience_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioRankingOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Ranking"
      }
    },
    "/portfolios/{portfolio_id}/loss-experience": {
      "get": {
        "operationId": "get_loss_experience_portfolios__portfolio_id__loss_experience_get",
        "parameters": [
          {
            "in": "path",
            "name": "portfolio_id",
            "required": true,
            "schema": {
              "title": "Portfolio Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioLossExperienceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No Asset belongs to this Portfolio"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Loss Experience"
      }
    }
  }
}
