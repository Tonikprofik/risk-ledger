{
  "components": {
    "schemas": {
      "AssessmentOut": {
        "properties": {
          "asset_id": {
            "title": "Asset Id",
            "type": "string"
          },
          "coverage_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coverage Fraction",
            "type": "number"
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceOut"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present if and only if status is ok.",
            "title": "Value"
          }
        },
        "required": [
          "asset_id",
          "status",
          "value",
          "coverage_fraction",
          "provenance"
        ],
        "title": "AssessmentOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "ProvenanceOut": {
        "properties": {
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "ProvenanceOut",
        "type": "object"
      },
      "Status": {
        "enum": [
          "ok",
          "insufficient_data"
        ],
        "title": "Status",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "the company task",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/assets/{asset_id}/assessment": {
      "get": {
        "operationId": "get_assessment_v1_assets__asset_id__assessment_get",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Unknown asset"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Assessment"
      }
    }
  }
}
